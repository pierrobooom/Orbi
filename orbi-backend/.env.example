# Supabase project URL — found in Supabase dashboard under Project Settings > API
SUPABASE_URL=

# Supabase anonymous/public key — safe to use client-side, limited permissions
SUPABASE_ANON_KEY=

# Supabase service role key — full DB access, never expose to client
SUPABASE_SERVICE_KEY=

# Supabase JWT secret — used to verify auth tokens (Project Settings > API > JWT Secret)
SUPABASE_JWT_SECRET=

# PostgreSQL connection string — used by psycopg2/pgvector directly
DATABASE_URL=

# Groq API key — used for Llama 3.1 8B inference (Free and Pro tier users)
GROQ_API_KEY=

# Anthropic API key — used for Claude Sonnet/Opus (Premium tier users only)
ANTHROPIC_API_KEY=

# Deepgram API key — cloud fallback for speech-to-text when on-device Whisper is unavailable
DEEPGRAM_API_KEY=

# ElevenLabs API key — text-to-speech for Pro and Premium tier users
ELEVENLABS_API_KEY=

# Runtime environment — controls logging, error verbosity, and debug behaviour
# Values: development | staging | production
ENVIRONMENT=development
